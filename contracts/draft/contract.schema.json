{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devops-g16.example/contracts/draft/contract.schema.json",
  "title": "B1 DRAFT service contract proposal",
  "allOf": [{ "$ref": "../task.schema.json" }],
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "job_type": { "const": "DRAFT" },
    "input": { "$ref": "#/$defs/input" },
    "output": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/output" }]
    }
  },
  "$comment": "The common schema owns lifecycle requirements; this schema refines service payloads only.",
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "repoUri": { "type": "string", "pattern": "^repo://" },
    "pinnedImage": { "type": "string", "pattern": "^.+@sha256:[a-fA-F0-9]{64}$" },
    "input": {
      "type": "object",
      "required": ["repository", "configuration_id", "build", "max_iterations", "timeout_seconds"],
      "properties": {
        "repository": {
          "type": "object",
          "required": ["url", "commit"],
          "properties": {
            "url": { "$ref": "#/$defs/text" },
            "commit": { "$ref": "#/$defs/commit" }
          }
        },
        "configuration_id": { "$ref": "#/$defs/text" },
        "build": {
          "type": "object",
          "required": ["project_root", "command", "verify_command"],
          "properties": {
            "project_root": { "$ref": "#/$defs/text" },
            "command": { "$ref": "#/$defs/text" },
            "verify_command": { "$ref": "#/$defs/text" }
          }
        },
        "max_iterations": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "attempt": {
      "type": "object",
      "required": ["iteration", "outcome", "log_artifact_ref"],
      "properties": {
        "iteration": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["BUILD_FAILED", "VERIFY_FAILED", "SUCCESS"] },
        "modification": { "$ref": "#/$defs/text" },
        "rationale": { "$ref": "#/$defs/text" },
        "log_artifact_ref": { "$ref": "#/$defs/text" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["build", "verify"],
      "properties": {
        "build": { "enum": ["PASS", "FAIL", "SKIPPED"] },
        "verify": { "enum": ["PASS", "FAIL", "SKIPPED"] }
      }
    },
    "output": {
      "type": "object",
      "required": ["image", "configuration_id", "dockerfile_artifact_ref", "attempts", "verification"],
      "properties": {
        "image": { "$ref": "#/$defs/pinnedImage" },
        "configuration_id": { "$ref": "#/$defs/text" },
        "dockerfile_artifact_ref": { "$ref": "#/$defs/text" },
        "attempts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attempt" } },
        "verification": { "$ref": "#/$defs/verification" }
      }
    }
  }
}
